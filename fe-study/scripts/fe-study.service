# FE Study の systemd ユーザーユニット雛形（Linux / Raspberry Pi 向け）
#
# 配置・有効化の手順:
#   mkdir -p ~/.config/systemd/user
#   cp ~/ffffuryo.github.io/fe-study/scripts/fe-study.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now fe-study.service
#   systemctl --user status fe-study.service      # 状態確認
#   journalctl --user -u fe-study.service -f      # ログ確認
#
# ※ ユーザーのログインセッションが無くてもサービスを動かし続けるには、
#   一度だけ次を実行する（再起動後も自動で起動させたい場合に必要）:
#     sudo loginctl enable-linger "$USER"
#   これをしないと、ログアウトした時点でユーザーサービスは停止する。
#
# ※ パスが ~/ffffuryo.github.io/fe-study 以外の場合は WorkingDirectory と
#   ExecStart の %h/ffffuryo.github.io/fe-study 部分を書き換えること。
#   %h はユーザーのホームディレクトリに展開される。
#
# 環境変数（FE_HOST / FE_PORT / FE_DB）を変えたい場合は [Service] に
#   Environment=FE_PORT=8000
# のように追記する。FE_HOST は 127.0.0.1 のままにすること（下記 Tailscale 参照）。

[Unit]
Description=FE Study (基本情報技術者試験 学習アプリ)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ffffuryo.github.io/fe-study
ExecStart=%h/ffffuryo.github.io/fe-study/.venv/bin/python -m app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
